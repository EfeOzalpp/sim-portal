# Copy this file to .env.video. The real .env.video file is gitignored.
DATABASE_URL="postgresql://sim:sim@localhost:5432/sim_video"

# The video seed refuses to run without both this flag and the sim_video database name.
ALLOW_VIDEO_SEED=true

# Use the Google account that will log in while recording.
VIDEO_ADMIN_EMAIL=demo.admin@example.test
