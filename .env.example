# Authentication
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database
DATABASE_URL="postgresql://sim:sim@localhost:5432/sim"

# Persistent user-image storage. On IONOS, use a directory outside the app
# deployment, for example: /var/lib/sim/user-images
IMAGE_STORAGE_DIR=
# Public HTTPS origin where nginx serves /media/user-images in production.
# Example: https://massartsim.fun
NEXT_PUBLIC_IMAGE_ORIGIN=

# Initial Admin User (Required to seed the database)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=

# Initial Semester (Required to seed the database)
INITIAL_SEMESTER_NAME=
INITIAL_SEMESTER_START=
INITIAL_SEMESTER_END=

